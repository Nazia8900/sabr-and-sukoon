# Public site URL (no trailing slash) — used for canonicals, sitemap, RSS, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.sabrandsukoon.online

# ── Admin auth ───────────────────────────────────────────────
# Generate the password hash with:  npm run seed-admin -- "your-strong-password"
# The hash is base64-encoded so the '$' characters survive env parsing — paste the
# value the seed script prints verbatim (no quotes needed).
ADMIN_USERNAME=nazia
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session JWT (use a long random string)
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Automation ingestion (draft-only) ────────────────────────
# Bearer token your automation (Make.com/Zapier/script) must send to POST /api/ingest
INGEST_TOKEN=

# Optional: token to trigger on-demand revalidation (POST /api/revalidate)
REVALIDATE_TOKEN=

# ── Content store (production) ───────────────────────────────
# Posts written in /admin need somewhere writable, because Vercel's filesystem
# is read-only. Create a Blob store in the Vercel dashboard (Storage → Create
# Database → Blob) and connect it to the project — Vercel injects these itself,
# so you do not set them by hand. Listed here only so you know what to expect.
#
#   BLOB_STORE_ID=store_xxxxxxxx
#
# The same private store holds post records, drafts, and uploaded media. Images
# are delivered publicly through this application's /media/* route.
#
# With no Blob store the public site still works; only saving from /admin fails.
# Locally nothing is needed — posts are written to content/editor-posts/.
